def top10_from_kg_greedy_descent(query):

    # 1. Query -> KG seeds
    phrases = extract_query_entities(query)
    seeds = link_entities(phrases) if phrases else []

    if not seeds:
        seeds = lexical_fallback(query, limit=8)

    if not seeds:
        print("No KG seed nodes found.")
        return {"predictions": [{"data": []}]}

    # 2. Prepare query
    query_tokens = tokens(query)
    query_set = set(query_tokens)
    query_bigrams = set(zip(query_tokens, query_tokens[1:]))

    query_idf_total = (
        sum(idf(t) for t in query_set)
        or 1.0
    )

    # 3. Greedy descent from every seed
    grounded_docs = set()
    greedy_paths = []

    for uri, _, _, _ in seeds:

        path, docs = greedy_descent(
            uri,
            query_set,
            query_bigrams,
            query_idf_total
        )

        greedy_paths.append(path)
        grounded_docs.update(docs)

    if not grounded_docs:
        print("Greedy descent found no KG-grounded documents.")
        return {"predictions": [{"data": []}]}

    # 4. Score chunks from Greedy-reached documents
    # Final ranking = 100% query relevance
    candidates = []

    for uri in grounded_docs:

        for c in KG10_CHUNKS[uri]:

            query_score = chunk_query_score(
                c,
                query_set,
                query_bigrams,
                query_idf_total
            )

            if query_score <= 0:
                continue

            candidates.append({
                **c,
                "_score": query_score,
                "_query_score": query_score
            })

    if not candidates:
        print("No query-relevant chunks found.")
        return {"predictions": [{"data": []}]}

    # 5. Pure Top-K after Greedy Descent
    candidates.sort(
        key=lambda c: c["_score"],
        reverse=True
    )

    chosen = []
    seen = set()
    per_doc = defaultdict(int)

    for c in candidates:

        key = re.sub(
            r"\s+",
            " ",
            c["content"].lower()
        ).strip()

        if key in seen:
            continue

        if per_doc[c["doc_uri"]] >= MAX_PER_DOC:
            continue

        seen.add(key)
        per_doc[c["doc_uri"]] += 1
        chosen.append(c)

        if len(chosen) == TOP_K:
            break

    # Fallback if document limit gives fewer than 10
    if len(chosen) < TOP_K:

        for c in candidates:

            key = re.sub(
                r"\s+",
                " ",
                c["content"].lower()
            ).strip()

            if key in seen:
                continue

            seen.add(key)
            chosen.append(c)

            if len(chosen) == TOP_K:
                break

    # 6. Response
    response_kg = {
        "predictions": [{
            "data": [{
                "content": c["content"],
                "title": c["title"],
                "reference": c["reference"]
            } for c in chosen]
        }]
    }

    # 7. Output
    print("\n" + "=" * 100)
    print("TOP 10 KG CHUNKS — GREEDY DESCENT")
    print("=" * 100)

    print("\nGREEDY PATHS")
    for i, path in enumerate(greedy_paths, 1):
        labels = [
            NODE_LABEL.get(uri, uri)
            for uri in path
        ]
        print(f"Seed {i}: {' -> '.join(labels)}")

    for i, c in enumerate(chosen, 1):

        print(f"\nCHUNK {i}")
        print("-" * 100)
        print(f"Content   : {c['content']}")
        print(f"Title     : {c['title']}")
        print(f"Reference : {c['reference']}")
        print(f"Score     : {c['_query_score']:.4f}")
        print("-" * 100)

    return response_kg


