for uri, edges in edges_by_doc.items():

    print("\n" + "-" * 80)
    print("DOCUMENT:", uri)
    print("-" * 80)

    graph_score = 0.0

    for rank, (edge, weight) in enumerate(
        zip(edges, weights),
        start=1
    ):

        edge_score = edge.get("score", 0)
        contribution = edge_score * weight

        graph_score += contribution

        print(
            f"Edge {rank}: "
            f"edge score={edge_score:.6f}, "
            f"weight={weight}, "
            f"contribution={contribution:.6f}"
        )

    seed_score = 0.0

    for seed_uri, label, score, extra in seeds:

        if seed_uri == uri:
            seed_score = max(
                seed_score,
                score / 100
            )

    raw_score = max(
        graph_score,
        seed_score
    )

