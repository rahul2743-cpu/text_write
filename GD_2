def top10_from_kg_greedy_descent(query):

    # 1. Query -> KG seed nodes
    phrases = extract_query_entities(query)
    seeds = link_entities(phrases) if phrases else []

    if not seeds:
        seeds = lexical_fallback(query, limit=8)

    if not seeds:
        print("No KG seed nodes found.")
        return {"predictions": [{"data": []}]}

    # 2. Prepare query
    query_tokens = tokens(query)
    query_set = set(query_tokens)
    query_bigrams = set(zip(query_tokens, query_tokens[1:]))

    query_idf_total = (
        sum(idf(t) for t in query_set)
        or 1.0
    )

    # 3. Greedy graph traversal
    expansion_order, grounded_docs = greedy_descent(
        seeds,
        query_set,
        query_bigrams,
        query_idf_total
    )

    if not grounded_docs:
        print("No KG-grounded documents found.")
        return {"predictions": [{"data": []}]}

    # 4. Score ALL chunks from Greedy-reached documents
    candidates = []

    for uri in grounded_docs:
        for c in KG10_CHUNKS[uri]:

            query_score = chunk_query_score(
                c,
                query_set,
                query_bigrams,
                query_idf_total
            )

            candidates.append({
                **c,
                "_score": query_score,
                "_query_score": query_score
            })

    if not candidates:
        print("No chunks found.")
        return {"predictions": [{"data": []}]}

    # 5. 100% QUERY-BASED TOP-K ranking
    candidates.sort(
        key=lambda c: c["_score"],
        reverse=True
    )

    chosen = []
    seen = set()

    for c in candidates:

        key = re.sub(
            r"\s+",
            " ",
            c["content"].lower()
        ).strip()

        if key in seen:
            continue

        seen.add(key)
        chosen.append(c)

        if len(chosen) == TOP_K:
            break

    # 6. Response
    response_kg = {
        "predictions": [{
            "data": [{
                "content": c["content"],
                "title": c["title"],
                "reference": c["reference"]
            } for c in chosen]
        }]
    }

    # 7. Output
    print("\n" + "=" * 100)
    print("TOP 10 KG CHUNKS — GREEDY DESCENT + QUERY RANKING")
    print("=" * 100)

    print(f"\nKG documents found : {len(grounded_docs)}")
    print(f"Candidate chunks   : {len(candidates)}")
    print(f"Final chunks       : {len(chosen)}")

    print("\nGREEDY EXPANSION")
    print("-" * 100)

    for i, uri in enumerate(expansion_order, 1):
        print(f"{i}. {NODE_LABEL.get(uri, uri)}")

    for i, c in enumerate(chosen, 1):
        print(f"\nCHUNK {i}")
        print("-" * 100)
        print(f"Content   : {c['content']}")
        print(f"Title     : {c['title']}")
        print(f"Reference : {c['reference']}")
        print(f"Score     : {c['_query_score']:.4f}")
        print("-" * 100)

    return response_kg


