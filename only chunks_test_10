def top10_from_kg(query):

    # 1. Query -> KG seed nodes
    phrases = extract_query_entities(query)
    seeds = link_entities(phrases) if phrases else []

    if not seeds:
        seeds = lexical_fallback(query, limit=8)

    if not seeds:
        print("No KG seed nodes found.")
        return {"predictions": [{"data": []}]}

    # 2. SPARQL / BFS multi-hop traversal
    edges, _ = traverse(seeds)

    # 3. Collect KG-grounded documents only
    grounded_docs = set()

    for e in edges:
        if e["source"] in KG10_CHUNKS:
            grounded_docs.add(e["source"])

        if e["target"] in KG10_CHUNKS:
            grounded_docs.add(e["target"])

    # Seed itself may also be a document
    for uri, _, _, _ in seeds:
        if uri in KG10_CHUNKS:
            grounded_docs.add(uri)

    if not grounded_docs:
        print("No KG-grounded documents found.")
        return {"predictions": [{"data": []}]}

    # 4. Prepare query once
    query_tokens = tokens(query)
    query_set = set(query_tokens)
    query_bigrams = set(zip(query_tokens, query_tokens[1:]))

    query_idf_total = (
        sum(idf(t) for t in query_set)
        or 1.0
    )

    # 5. Score ALL KG-grounded chunks
    # Ranking = 100% QUERY relevance
    candidates = []

    for uri in grounded_docs:
        for c in KG10_CHUNKS[uri]:

            token_score = (
                sum(
                    idf(t)
                    for t in query_set
                    if t in c["_tokens"]
                )
                / query_idf_total
            )

            bigram_score = (
                len(query_bigrams & c["_bigrams"])
                / len(query_bigrams)
                if query_bigrams else 0.0
            )

            query_score = (
                0.85 * token_score +
                0.15 * bigram_score
            )

            if query_score <= 0:
                continue

            candidates.append({
                **c,
                "_score": query_score,
                "_query_score": query_score
            })

    if not candidates:
        print("No query-relevant KG chunks found.")
        return {"predictions": [{"data": []}]}

    # ======================================================
    # 6. GLOBAL GREEDY MMR TOP-10
    # ======================================================

    remaining = candidates.copy()
    chosen = []
    seen = set()
    per_doc = defaultdict(int)

    while len(chosen) < TOP_K and remaining:

        # First chunk = highest query relevance
        if not chosen:
            best = max(
                remaining,
                key=lambda c: c["_score"]
            )

        # Next chunks = query relevance - similarity penalty
        else:
            best = max(
                remaining,
                key=lambda c:
                    MMR_LAMBDA * c["_score"]
                    - (1 - MMR_LAMBDA) * max(
                        jaccard(c["_tokens"], s["_tokens"])
                        for s in chosen
                    )
            )

        remaining.remove(best)

        key = re.sub(
            r"\s+",
            " ",
            best["content"].lower()
        ).strip()

        # Exact duplicate
        if key in seen:
            continue

        # Max 3 chunks from same document
        if per_doc[best["doc_uri"]] >= MAX_PER_DOC:
            continue

        seen.add(key)
        per_doc[best["doc_uri"]] += 1
        chosen.append(best)

    # 7. Fallback: fill to 10 if MAX_PER_DOC prevented it
    if len(chosen) < TOP_K:

        for c in sorted(
            candidates,
            key=lambda x: x["_score"],
            reverse=True
        ):
            key = re.sub(
                r"\s+",
                " ",
                c["content"].lower()
            ).strip()

            if key in seen:
                continue

            seen.add(key)
            chosen.append(c)

            if len(chosen) == TOP_K:
                break

    # 8. Response
    response_kg = {
        "predictions": [{
            "data": [{
                "content": c["content"],
                "title": c["title"],
                "reference": c["reference"]
            } for c in chosen]
        }]
    }

    # 9. Clean final output — same style as previous code
    print("\n" + "=" * 100)
    print("TOP 10 KG CHUNKS — 100% QUERY RELEVANCE + GREEDY MMR")
    print("=" * 100)

    for i, c in enumerate(chosen, 1):
        print(f"\nCHUNK {i}")
        print("-" * 100)
        print(f"Content   : {c['content']}")
        print(f"Title     : {c['title']}")
        print(f"Reference : {c['reference']}")
        print("-" * 100)

    return response_kg


