import re, math
from collections import defaultdict, Counter

TOP_K = 10
MAX_PER_DOC = 3
CHUNK_SIZE, MIN_CHUNK = 900, 120
MMR_LAMBDA = 0.80

STOP = {
    "a","an","the","is","are","was","were","be","been","being",
    "of","to","for","from","in","on","at","by","with","and","or",
    "what","which","who","where","when","why","how",
    "does","do","did","should","would","could","can","may","might"
}

MARKUP = re.compile(r"\[?<doc:(?:wiki:)?[^<>]+>\]?")

def tokens(text):
    return [
        w for w in re.findall(r"[a-z0-9]+", str(text).lower())
        if len(w) > 1 and w not in STOP
    ]

def split_chunks(text):
    text = re.sub(r"\s+", " ", MARKUP.sub(" ", str(text or ""))).strip()
    sents = [s.strip() for s in re.split(r"(?<=[.!?])\s+", text) if s.strip()]
    out, buf = [], ""

    for s in sents:
        if len(s) > CHUNK_SIZE:
            if len(buf) >= MIN_CHUNK:
                out.append(buf)
            buf = ""
            out += [
                s[i:i+CHUNK_SIZE]
                for i in range(0, len(s), CHUNK_SIZE)
                if len(s[i:i+CHUNK_SIZE]) >= MIN_CHUNK
            ]
        elif len(buf) + len(s) + 1 <= CHUNK_SIZE:
            buf = f"{buf} {s}".strip()
        else:
            if len(buf) >= MIN_CHUNK:
                out.append(buf)
            buf = s

    if len(buf) >= MIN_CHUNK:
        out.append(buf)

    return out

def jaccard(a, b):
    return len(a & b) / len(a | b) if a and b else 0.0


# ==========================================================
# BUILD KG CHUNK INDEX ONCE
