                "_tokens": set(ts),
                "_bigrams": set(zip(ts, ts[1:]))
            }

            KG10_CHUNKS[uri].append(chunk)
            KG10_DF.update(chunk["_tokens"])
            KG10_TOTAL += 1

    print(f"Cached: {KG10_TOTAL} chunks / {len(KG10_CHUNKS)} documents")


def idf(token):
    return math.log(
        (KG10_TOTAL + 1) /
        (KG10_DF.get(token, 0) + 1)
    ) + 1


