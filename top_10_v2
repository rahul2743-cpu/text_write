# ==========================================================
# CELL 20 — GRAPH-AWARE KG TOP-10
# KG -> 2-Hop BFS -> Graph + Query Score -> MMR -> Top 10
# No embeddings | No vector search | No BM25 | Generic
# ==========================================================

import re, math, json
from collections import defaultdict, Counter
from difflib import SequenceMatcher

TOP_K = 10
MAX_HOPS = 2
MAX_PER_DOC = 3
CHUNK_SIZE = 900
MIN_CHUNK = 120
MMR_LAMBDA = 0.82

# Final score weights
W_QUERY = 0.45
W_LOCAL_GRAPH = 0.35
W_DOC_GRAPH = 0.20

TOP_EDGES_PER_DOC = 5

STOP = {
    "a","an","the","is","are","was","were","be","been","being",
    "of","to","for","from","in","on","at","by","with","and","or",
    "what","which","who","where","when","why","how",
    "does","do","did","should","would","could","can","may","might"
}

MARKUP = re.compile(r"\[?<doc:(?:wiki:)?[^<>]+>\]?")


# ==========================================================
# HELPERS
# ==========================================================

def tokens(text):
    return {
        w for w in re.findall(r"[a-z0-9]+", str(text or "").lower())
        if len(w) > 1 and w not in STOP
    }


def split_chunks(text):
    text = re.sub(r"\s+", " ", MARKUP.sub(" ", str(text or ""))).strip()
    if not text:
        return []

    sents = [
        s.strip()
        for s in re.split(r"(?<=[.!?])\s+", text)
        if s.strip()
    ]

    chunks, buf = [], ""

    for s in sents:
        if len(s) > CHUNK_SIZE:
            if len(buf) >= MIN_CHUNK:
                chunks.append(buf)
            buf = ""

            for i in range(0, len(s), CHUNK_SIZE):
                part = s[i:i + CHUNK_SIZE].strip()
                if len(part) >= MIN_CHUNK:
                    chunks.append(part)

        elif len(buf) + len(s) + 1 <= CHUNK_SIZE:
            buf = f"{buf} {s}".strip()

        else:
            if len(buf) >= MIN_CHUNK:
                chunks.append(buf)
            buf = s

    if len(buf) >= MIN_CHUNK:
        chunks.append(buf)

    return chunks


def jaccard(a, b):
    union = a | b
    return len(a & b) / len(union) if union else 0.0


# Cell 16 uses fuzzy_match()
if "fuzzy_match" not in globals():

    def fuzzy_match(query, choices, limit=3, cutoff=72):
        query = str(query or "").lower().strip()
        scores = []

        for choice in choices:
            c = str(choice or "").lower().strip()

            if not c:
                continue

            score = SequenceMatcher(None, query, c).ratio() * 100

            if score >= cutoff:
                scores.append((choice, score))

        return sorted(
            scores,
            key=lambda x: x[1],
            reverse=True
        )[:limit]


# ==========================================================
# BUILD KG CHUNK INDEX
# ==========================================================

DOC_Q = PREFIXES + """
SELECT ?doc ?label ?ref ?content
WHERE {
    ?doc ex:documentContent ?content .
    OPTIONAL { ?doc rdfs:label ?label }
    OPTIONAL { ?doc ex:sourceReference ?ref }
}
"""

KG_CHUNKS = defaultdict(list)
KG_DF = Counter()
KG_TOTAL = 0

for r in g.query(DOC_Q):

    uri = str(r.doc)

    title = (
        str(r.label)
        if r.label
        else NODE_LABEL.get(uri, uri)
    )

    reference = (
        str(r.ref)
        if r.ref
        else uri
    )

    for idx, text in enumerate(split_chunks(str(r.content))):

        ts = tokens(text)

        if not ts:
            continue

        chunk = {
            "chunk_id": idx,
            "content": text,
            "title": title,
            "reference": reference,
            "doc_uri": uri,
            "_tokens": ts
        }

        KG_CHUNKS[uri].append(chunk)
        KG_DF.update(ts)
        KG_TOTAL += 1


print(
    f"Cached: {KG_TOTAL} chunks / "
    f"{len(KG_CHUNKS)} documents"
)


# ==========================================================
# SCORING FUNCTIONS
# ==========================================================

def idf(token):
    return math.log(
        (KG_TOTAL + 1) /
        (KG_DF.get(token, 0) + 1)
    ) + 1


def coverage(important, chunk_tokens):

    important = set(important)

    if not important:
        return 0.0

    total = sum(idf(t) for t in important) or 1.0

    return (
        sum(
            idf(t)
            for t in important
            if t in chunk_tokens
        )
        / total
    )


def local_graph_score(chunk_tokens, edge):

    anchor = tokens(
        f"{edge.get('source_label','')} "
        f"{edge.get('predicate','')} "
        f"{edge.get('target_label','')}"
    )

    description = tokens(
        edge.get("description", "")
    )

    return (
        0.70 * coverage(anchor, chunk_tokens)
        + 0.30 * coverage(description, chunk_tokens)
    )


def get_doc_scores(ranked_edges, seeds):

    edges_by_doc = defaultdict(list)
    seed_scores = {}

    for e in ranked_edges:

        for side in ("source", "target"):

            uri = e[side]

            if uri in KG_CHUNKS:
                edges_by_doc[uri].append(e)

    for uri, _, score, _ in seeds:

        if uri in KG_CHUNKS:
            seed_scores[uri] = max(
                seed_scores.get(uri, 0),
                score / 100
            )

    docs = set(edges_by_doc) | set(seed_scores)
    raw = {}

    weights = [1.0, 0.5, 0.25, 0.125, 0.0625]

    for uri in docs:

        es = sorted(
            edges_by_doc.get(uri, []),
            key=lambda x: x.get("score", 0),
            reverse=True
        )[:TOP_EDGES_PER_DOC]

        edges_by_doc[uri] = es

        graph_score = sum(
            e.get("score", 0) * w
            for e, w in zip(es, weights)
        )

        raw[uri] = max(
            graph_score,
            seed_scores.get(uri, 0)
        )

    max_score = max(raw.values(), default=1.0) or 1.0

    normalized = {
        uri: score / max_score
        for uri, score in raw.items()
    }

    return normalized, edges_by_doc


# ==========================================================
# MAIN KG TOP-10 RETRIEVER
# ==========================================================

def top10_from_kg(query, debug=False):

    # 1. Query -> entities -> KG seeds
    phrases = extract_query_entities(query)

    seeds = (
        link_entities(phrases)
        if phrases else []
    )

    if not seeds:
        seeds = lexical_fallback(query, limit=8)

    if not seeds:
        print("No KG seed nodes found.")
        return {"predictions": [{"data": []}]}

    # 2. BFS Hop-1 + Hop-2
    edges, _ = traverse(seeds)

    # 3. Graph edge ranking
    ranked_edges = rank_edges(edges) if edges else []

    # 4. Graph relevance for each document
    doc_scores, edges_by_doc = get_doc_scores(
        ranked_edges,
        seeds
    )

    grounded_docs = set(doc_scores)

    if not grounded_docs:
        print("No KG-grounded documents found.")
        return {"predictions": [{"data": []}]}

    # 5. Score all chunks
    query_tokens = tokens(query)
    candidates = []

    for uri in grounded_docs:

        doc_score = doc_scores.get(uri, 0)
        doc_edges = edges_by_doc.get(uri, [])

        max_edge = max(
            (
                e.get("score", 0)
                for e in doc_edges
            ),
            default=0
        )

        for c in KG_CHUNKS[uri]:

            query_score = coverage(
                query_tokens,
                c["_tokens"]
            )

            graph_score = 0.0

            for e in doc_edges:

                importance = (
                    e.get("score", 0) / max_edge
                    if max_edge > 0
                    else 0
                )

                score = (
                    local_graph_score(
                        c["_tokens"],
                        e
                    )
                    * importance
                )

                graph_score = max(
                    graph_score,
                    score
                )

            # Keep direct or graph-related chunks
            if query_score <= 0 and graph_score <= 0:
                continue

            final_score = (
                W_QUERY * query_score
                + W_LOCAL_GRAPH * graph_score
                + W_DOC_GRAPH * doc_score
            )

            candidates.append({
                **c,
                "_score": final_score,
                "_query": query_score,
                "_graph": graph_score,
                "_doc": doc_score
            })

    if not candidates:
        print("No relevant KG chunks found.")
        return {"predictions": [{"data": []}]}

    # ======================================================
    # 6. GLOBAL GREEDY MMR
    # ======================================================

    remaining = candidates.copy()
    chosen = []
    seen = set()
    per_doc = defaultdict(int)

    while len(chosen) < TOP_K and remaining:

        eligible = [
            c for c in remaining
            if per_doc[c["doc_uri"]] < MAX_PER_DOC
        ]

        if not eligible:
            break

        def mmr(c):

            redundancy = max(
                (
                    jaccard(
                        c["_tokens"],
                        s["_tokens"]
                    )
                    for s in chosen
                ),
                default=0
            )

            return (
                MMR_LAMBDA * c["_score"]
                - (1 - MMR_LAMBDA) * redundancy
            )

        best = max(
            eligible,
            key=mmr
        )

        remaining.remove(best)

        key = re.sub(
            r"\s+",
            " ",
            best["content"].lower()
        ).strip()

        if key in seen:
            continue

        seen.add(key)
        per_doc[best["doc_uri"]] += 1
        chosen.append(best)

    # ======================================================
    # 7. FALLBACK — KEEP DOC LIMIT
    # ======================================================

    if len(chosen) < TOP_K:

        for c in sorted(
            candidates,
            key=lambda x: x["_score"],
            reverse=True
        ):

            if len(chosen) >= TOP_K:
                break

            key = re.sub(
                r"\s+",
                " ",
                c["content"].lower()
            ).strip()

            if key in seen:
                continue

            if per_doc[c["doc_uri"]] >= MAX_PER_DOC:
                continue

            seen.add(key)
            per_doc[c["doc_uri"]] += 1
            chosen.append(c)

    # ======================================================
    # 8. LAST FALLBACK — ENSURE TOP 10 IF POSSIBLE
    # ======================================================

    if len(chosen) < TOP_K:

        for c in sorted(
            candidates,
            key=lambda x: x["_score"],
            reverse=True
        ):

            if len(chosen) >= TOP_K:
                break

            key = re.sub(
                r"\s+",
                " ",
                c["content"].lower()
            ).strip()

            if key in seen:
                continue

            seen.add(key)
            chosen.append(c)

    # ======================================================
    # 9. OPTIONAL DEBUG
    # ======================================================

    if debug:

        print(f"\nQuery: {query}")
        print(f"Entities: {[p for p, _ in phrases]}")
        print(f"Seeds: {len(seeds)}")
        print(f"Edges: {len(edges)}")
        print(f"KG Docs: {len(grounded_docs)}")
        print(f"Candidates: {len(candidates)}")

        for i, c in enumerate(chosen[:TOP_K], 1):
            print(
                f"{i}. {c['title']} | "
                f"final={c['_score']:.3f} | "
                f"query={c['_query']:.3f} | "
                f"graph={c['_graph']:.3f} | "
                f"doc={c['_doc']:.3f}"
            )

    # ======================================================
    # 10. FINAL OUTPUT — SAME FORMAT AS VECTOR SEARCH
    # ======================================================

    return {
        "predictions": [{
            "data": [
                {
                    "content": c["content"],
                    "title": c["title"],
                    "reference": c["reference"]
                }
                for c in chosen[:TOP_K]
            ]
        }]
    }


