# --- GET WEIGHTS ---
W_QUERY, W_LOCAL_GRAPH, W_DOC_GRAPH = get_weights(
    query,
    seeds,
    query_tokens
)

print("\n" + "=" * 100)
print("WEIGHTS")
print("=" * 100)

print("W_QUERY       :", W_QUERY)
print("W_LOCAL_GRAPH :", W_LOCAL_GRAPH)
print("W_DOC_GRAPH   :", W_DOC_GRAPH)

candidates = []

print("\n" + "=" * 100)
print("GROUNDED DOCUMENTS")
print("=" * 100)

print("Number of grounded documents:", len(grounded_docs))
print("Grounded documents:", grounded_docs)


for uri in grounded_docs:

    print("\n" + "-" * 100)
    print("PROCESSING DOCUMENT")
    print("-" * 100)
    print("Document URI:", uri)

    doc_score = doc_scores.get(uri, 0)
    doc_edges = edges_by_doc.get(uri, [])

    print("Document score:", doc_score)
    print("Number of document edges:", len(doc_edges))

    max_edge = max(
        (e.get("score", 0) for e in doc_edges),
        default=0
    )

    print("Maximum edge score:", max_edge)

    chunks = KG_CHUNKS.get(uri, [])

    print("Number of chunks in this document:", len(chunks))

    for chunk_number, c in enumerate(chunks, start=1):

        print("\n" + "." * 80)
        print("PROCESSING CHUNK", chunk_number)
        print("." * 80)

        print("Chunk ID:", c.get("chunk_id"))
        print("Chunk title:", c.get("title"))
        print("Chunk content:", c.get("content", "")[:300])

        # Query relevance score
        query_score = coverage(
            query_tokens,
            c["_tokens"]
        )

        print("Query score:", query_score)

        # Graph relevance score
        graph_score = 0.0

        for edge_number, e in enumerate(doc_edges, start=1):

            importance = (
                e.get("score", 0) / max_edge
                if max_edge > 0
                else 0
            )

            local_score = local_graph_score(
                c["_tokens"],
                e
            )

            score = local_score * importance

            print(f"\nEdge {edge_number}")
            print("Source:", e.get("source"))
            print("Target:", e.get("target"))
            print("Predicate:", e.get("predicate"))
            print("Edge score:", e.get("score"))
            print("Edge importance:", importance)
            print("Local graph score:", local_score)
            print("Final edge contribution:", score)

            graph_score = max(
                graph_score,
                score
            )

        print("\nFinal graph score:", graph_score)

        # Ignore irrelevant chunks
        if query_score <= 0 and graph_score <= 0:
            print("RESULT: Chunk skipped because both scores are zero.")
            continue

        # Final weighted score
        final_score = (
            W_QUERY * query_score
            + W_LOCAL_GRAPH * graph_score
            + W_DOC_GRAPH * doc_score
        )

        print("\nFINAL SCORE CALCULATION")
        print(
            f"{W_QUERY} * {query_score} + "
            f"{W_LOCAL_GRAPH} * {graph_score} + "
            f"{W_DOC_GRAPH} * {doc_score}"
        )

        print("Final chunk score:", final_score)

        candidates.append({
            **c,
            "_score": final_score,
            "_query": query_score,
            "_graph": graph_score,
            "_doc": doc_score
        })

        print("RESULT: Chunk added to candidates.")

print("\n" + "=" * 100)
print("CANDIDATE SUMMARY")
print("=" * 100)

print("Total candidate chunks:", len(candidates))

for index, candidate in enumerate(candidates, start=1):

    print("\nCandidate", index)
    print("Chunk ID:", candidate.get("chunk_id"))
    print("Document:", candidate.get("doc_uri"))
    print("Final score:", candidate.get("_score"))
    print("Query score:", candidate.get("_query"))
    print("Graph score:", candidate.get("_graph"))
    print("Document score:", candidate.get("_doc"))

if not candidates:
    print("\nNo relevant KG chunks found.")

    result = {
        "predictions": [
            {
                "data": []
            }
        ]
    }

else:
    result = {
        "predictions": [
            {
                "data": candidates
            }
        ]
    }

print("\n" + "=" * 100)
print("FINAL OUTPUT OF THIS CODE BLOCK")
print("=" * 100)

print(json.dumps(
    result,
    indent=2,
    ensure_ascii=False
))
