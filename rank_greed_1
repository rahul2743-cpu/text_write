# ==========================================================
# KG CHUNK SCORING
# ==========================================================

# Convert the user query into tokens
query_tokens = tokens(query)

# Get scoring weights
W_QUERY, W_LOCAL_GRAPH, W_DOC_GRAPH = get_weights(
    query=query,
    seeds=seeds,
    query_tokens=query_tokens
)

# Store all relevant chunk candidates
candidates = []

# Iterate through documents selected by graph retrieval
for uri in grounded_docs:

    # Document-level graph score
    doc_score = doc_scores.get(uri, 0.0)

    # Get graph edges related to this document
    doc_edges = edges_by_doc.get(uri, [])

    # Find the highest edge score for this document
    max_edge = max(
        (e.get("score", 0.0) for e in doc_edges),
        default=0.0
    )

    # Iterate through all prepared chunks of the document
    for c in KG_CHUNKS.get(uri, []):

        # --------------------------------------------------
        # 1. Query-level relevance
        # --------------------------------------------------

        query_score = coverage(
            query_tokens,
            c["_tokens"]
        )

        # --------------------------------------------------
        # 2. Local graph relevance
        # --------------------------------------------------

        graph_score = 0.0

        # Check every graph edge connected to this document
        for e in doc_edges:

            edge_score = e.get("score", 0.0)

            # Normalize the edge score
            if max_edge > 0:
                importance = edge_score / max_edge
            else:
                importance = 0.0

            # Calculate how strongly this chunk matches the edge
            local_score = local_graph_score(
                c["_tokens"],
                e
            )

            # Combine local graph score with edge importance
            weighted_graph_score = local_score * importance

            # Keep the highest graph score for this chunk
            graph_score = max(
                graph_score,
                weighted_graph_score
            )

        # --------------------------------------------------
        # 3. Remove completely irrelevant chunks
        # --------------------------------------------------

        if query_score <= 0 and graph_score <= 0:
            continue

        # --------------------------------------------------
        # 4. Calculate final chunk score
        # --------------------------------------------------

        final_score = (
            W_QUERY * query_score
            + W_LOCAL_GRAPH * graph_score
            + W_DOC_GRAPH * doc_score
        )

        # --------------------------------------------------
        # 5. Store the chunk and all score components
        # --------------------------------------------------

        candidates.append({
            **c,

            # Final combined score
            "_score": final_score,

            # Individual scores for debugging
            "_query": query_score,
            "_graph": graph_score,
            "_doc": doc_score
        })


# ==========================================================
# HANDLE EMPTY RESULTS
# ==========================================================

if not candidates:
    print("No relevant KG chunks found.")

    return {
        "predictions": [
            {
                "data": []
            }
        ]
    }


# ==========================================================
# SORT CANDIDATES BY FINAL SCORE
# ==========================================================

candidates = sorted(
    candidates,
    key=lambda x: x["_score"],
    reverse=True
)

print(f"Total relevant candidates: {len(candidates)}")

# Display the top candidates for debugging
for i, c in enumerate(candidates[:10], start=1):

    print(f"\nCandidate {i}")
    print(f"Document : {c.get('doc_id', 'N/A')}")
    print(f"Chunk    : {c.get('chunk_id', 'N/A')}")
    print(f"Final    : {c['_score']:.4f}")
    print(f"Query    : {c['_query']:.4f}")
    print(f"Graph    : {c['_graph']:.4f}")
    print(f"Doc      : {c['_doc']:.4f}")
    print(f"Text     : {c.get('text', '')[:300]}")




