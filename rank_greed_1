# --- GET WEIGHTS ---
W_QUERY, W_LOCAL_GRAPH, W_DOC_GRAPH = get_weights(
    query,
    seeds,
    query_tokens
)

print("\nWEIGHTS")
print("W_QUERY       =", W_QUERY)
print("W_LOCAL_GRAPH =", W_LOCAL_GRAPH)
print("W_DOC_GRAPH   =", W_DOC_GRAPH)

candidates = []

for uri in grounded_docs:

    print("\n" + "=" * 80)
    print("DOCUMENT:", uri)
    print("=" * 80)

    doc_score = doc_scores.get(uri, 0)
    doc_edges = edges_by_doc.get(uri, [])

    print("doc_score:", doc_score)
    print("number of edges:", len(doc_edges))

    max_edge = max(
        (e.get("score", 0) for e in doc_edges),
        default=0
    )

    print("max_edge:", max_edge)

    for chunk_number, c in enumerate(
        KG_CHUNKS.get(uri, []),
        start=1
    ):

        print("\n" + "-" * 80)
        print("CHUNK:", chunk_number)
        print("Chunk ID:", c.get("chunk_id"))

        query_score = coverage(
            query_tokens,
            c["_tokens"]
        )

        print("query_score:", query_score)

        graph_score = 0.0

        for edge_number, e in enumerate(doc_edges, start=1):

            importance = (
                e.get("score", 0) / max_edge
                if max_edge > 0
                else 0
            )

            local_score = local_graph_score(
                c["_tokens"],
                e
            )

            score = local_score * importance

            print("\nEdge:", edge_number)
            print("edge score:", e.get("score", 0))
            print("importance:", importance)
            print("local graph score:", local_score)
            print("edge contribution:", score)

            graph_score = max(
                graph_score,
                score
            )

        print("\nFinal graph score:", graph_score)

        if query_score <= 0 and graph_score <= 0:
            print("Chunk skipped")
            continue

        final_score = (
            W_QUERY * query_score
            + W_LOCAL_GRAPH * graph_score
            + W_DOC_GRAPH * doc_score
        )

        print("\nCALCULATION")
        print(
            f"{W_QUERY} * {query_score} "
            f"+ {W_LOCAL_GRAPH} * {graph_score} "
            f"+ {W_DOC_GRAPH} * {doc_score}"
        )

        print("FINAL SCORE:", final_score)

        candidates.append({
            **c,
            "_score": final_score,
            "_query": query_score,
            "_graph": graph_score,
            "_doc": doc_score
        })

print("\n" + "=" * 80)
print("TOTAL CANDIDATES:", len(candidates))
print("=" * 80)

for i, c in enumerate(candidates, start=1):
    print("\nCandidate", i)
    print("Chunk ID:", c.get("chunk_id"))
    print("Final score:", c.get("_score"))
    print("Query score:", c.get("_query"))
    print("Graph score:", c.get("_graph"))
    print("Document score:", c.get("_doc"))
