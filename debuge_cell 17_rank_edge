# ==========================================================
# DEBUG CELL — rank_edges()
# ==========================================================

def rank_edges_debug(edges):

    print("=" * 80)
    print("RANK EDGES DEBUG")
    print("=" * 80)

    if not edges:
        print("No edges received.")
        return []

    debug_edges = []

    for i, e in enumerate(edges, start=1):

        # 1. Get degrees
        source_degree = _degree(e["source"])
        target_degree = _degree(e["target"])

        deg = source_degree + target_degree

        # 2. Score components
        seed_component = e["seed_score"] / 100.0

        hop_component = HOP_DECAY ** (e["hop"] - 1)

        strength_component = e["strength"] / 10.0

        degree_component = (
            1.0 + math.log1p(deg) / 12.0
        )

        # 3. Final score
        score = (
            seed_component
            * hop_component
            * strength_component
            * degree_component
        )

        # Copy edge so original is not modified
        e_copy = dict(e)
        e_copy["score"] = score

        debug_edges.append(e_copy)

        # 4. Print
        print(f"\nEDGE {i}")
        print("-" * 80)

        print(f"Source          : {e['source_label']}")
        print(f"Target          : {e['target_label']}")
        print(f"Predicate       : {e['predicate']}")

        print(f"Source degree   : {source_degree}")
        print(f"Target degree   : {target_degree}")
        print(f"Total degree    : {deg}")

        print(f"Seed score      : {e['seed_score']}")
        print(f"Hop             : {e['hop']}")
        print(f"Strength        : {e['strength']}")

        print(f"Seed component  : {seed_component:.4f}")
        print(f"Hop component   : {hop_component:.4f}")
        print(f"Strength comp.  : {strength_component:.4f}")
        print(f"Degree component: {degree_component:.4f}")

        print(f"Final score     : {score:.6f}")

        print(
            f"Calculation     : "
            f"{seed_component:.4f} × "
            f"{hop_component:.4f} × "
            f"{strength_component:.4f} × "
            f"{degree_component:.4f}"
        )

    return sorted(
        debug_edges,
        key=lambda x: x["score"],
        reverse=True
    )
